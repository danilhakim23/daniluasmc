PORT=5000
FRONTEND_URL=https://your-frontend-url.vercel.app
# Railway MySQL plugin env vars
MYSQL_HOST=your-railway-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-railway-mysql-user
MYSQL_PASSWORD=your-railway-mysql-password
MYSQL_DATABASE=your-railway-mysql-db

# Or use a single connection string if Railway provides it
# DATABASE_URL=mysql://user:password@host:port/database
# MYSQL_URL=mysql://user:password@host:port/database
